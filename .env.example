# Copiá este archivo a .env.local y completá los valores reales.
# Ninguno de estos valores debe subirse al repo.

# --- Base de datos ---
# Cadena de conexion de Neon/Postgres. lib/db/neon.ts
DATABASE_URL=

# --- Sesion de admin ---
# Secreto para firmar la cookie de sesion del panel /admin. lib/auth/admin.ts
ADMIN_SESSION_SECRET=

# --- Cron de purga automatica ---
# Token que valida las llamadas al endpoint de purga. app/api/cron/purgar/route.ts
CRON_SECRET=

# --- Almacenamiento de fotos (Vercel Blob) ---
# Definir solo uno de los dos alcanza para habilitar la subida de fotos. lib/blob/fotos.ts
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# --- Flags publicos (se inline-an en el build, quedan visibles en el cliente) ---

# Prende/apaga la ruta /inventario-predictivo y su entrada en "El enfoque".
# Con "false" o sin definir, la ruta responde 404 y no aparece en la nav.
NEXT_PUBLIC_MODULO_INVENTARIO=false

# URL del repo que se muestra en el footer. Si no esta definida, el link no se renderiza.
# NEXT_PUBLIC_REPO_URL=https://github.com/Luis-Vanegas/territorio-inn-2026-manrique
